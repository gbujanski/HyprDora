<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>HyprDora</vendor>
  <vendor_url>https://github.com/gbujanski/HyprDora</vendor_url>

  <action id="org.hyprdora.offline-update">
    <description>Install system updates</description>
    <description xml:lang="pl">Instalacja aktualizacji systemu</description>
    <message>Authentication is required to download updates and install them on restart</message>
    <message xml:lang="pl">Wymagane jest uwierzytelnienie, aby pobrać aktualizacje i zainstalować je przy ponownym uruchomieniu</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/hyprdora/offline-update</annotate>
  </action>
</policyconfig>
