pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland
import qs.config

// Keyboard layouts, pointer speed and the touchpad. Hyprland reads them from input.lua in the user's
// Hyprland directory, which the shell writes whole from the settings, as it writes monitors.lua; a change
// also applies at once. The user's settings.lua loads after it and wins. Without layouts in the settings,
// the system's layouts from the installer apply. The names of all layouts come from xkeyboard-config,
// translated into the shell's language, and are read only when something shows them.
Singleton {
    id: root

    // Whether this computer has a touchpad, from udev; settings for it show only then.
    property bool touchpadPresent: false
    readonly property bool naturalScroll: Settings.touchpadNaturalScroll
    readonly property bool tapToClick: Settings.touchpadTapToClick
    readonly property real pointerSpeed: Settings.pointerSpeed

    // The system's layouts, from localectl, and whether they have been read.
    property var systemLayouts: []
    property bool systemRead: false
    // The layouts in use, the first the default: [{ layout, variant }].
    readonly property var layouts: {
        const chosen = valid(Settings.keyboardLayouts);
        if (chosen.length > 0)
            return chosen;
        return systemLayouts.length > 0 ? systemLayouts : [
            {
                layout: "us",
                variant: ""
            }
        ];
    }
    // The active layout's place in layouts, as Hyprland reports it.
    property int activeIndex: 0
    readonly property var active: layouts[activeIndex] ?? layouts[0]
    // Shows the indicator once the layout the user switched to is known.
    property bool announce: false

    // Every layout and variant: [{ layout, variant, name }], in xkeyboard-config's order; empty until loaded.
    property var catalog: []
    property bool catalogWanted: false

    readonly property string configPath: `${Settings.configDir}/hypr/input.lua`
    readonly property string config: {
        const lua = v => `"${v}"`;
        const speed = Math.round(pointerSpeed * 100) / 100;
        return `-- Generated by the HyprDora shell from its settings. Do not edit.\nhl.config({\n    input = {\n        kb_layout = ${lua(layouts.map(l => l.layout).join(","))},\n        kb_variant = ${lua(layouts.map(l => l.variant).join(","))},\n        sensitivity = ${speed},\n        touchpad = {\n            natural_scroll = ${naturalScroll},\n            tap_to_click = ${tapToClick},\n        },\n    },\n})\n`;
    }

    onConfigChanged: write()
    onSystemReadChanged: write()
    onLayoutsChanged: if (layouts.length > 1)
        loadCatalog()

    /**
     * Keeps the well-formed entries of a list of layouts, so nothing else reaches the Lua file.
     * @param {var} list  layouts from the settings
     * @returns {array} [{ layout, variant }]
     */
    function valid(list) {
        if (!Array.isArray(list))
            return [];
        return list.filter(l => /^[a-z0-9_]+$/.test(l?.layout ?? "") && /^[A-Za-z0-9_-]*$/.test(l?.variant ?? "")).map(l => ({
                    layout: l.layout,
                    variant: l.variant ?? ""
                }));
    }

    /** Writes input.lua when it differs from the settings, and applies it now. */
    function write() {
        if (!systemRead || configFile.text() === config)
            return;
        configFile.setText(config);
        // The whole file as one statement, without its comment line.
        Quickshell.execDetached(["hyprctl", "eval", config.split("\n").slice(1).join(" ")]);
    }

    /**
     * Sets the touchpad's scrolling direction.
     * @param {bool} natural  true to move the content with the fingers, as on a phone
     */
    function setNaturalScroll(natural) {
        Settings.set("touchpadNaturalScroll", natural ? true : undefined);
    }

    /**
     * Sets whether a tap on the touchpad clicks.
     * @param {bool} enabled  whether a tap clicks
     */
    function setTapToClick(enabled) {
        Settings.set("touchpadTapToClick", enabled ? undefined : false);
    }

    /**
     * Sets the pointer speed of the mouse and the touchpad.
     * @param {real} speed  from -1 to 1, 0 being the default
     */
    function setPointerSpeed(speed) {
        const rounded = Math.round(Math.max(-1, Math.min(1, speed)) * 20) / 20;
        Settings.set("pointerSpeed", rounded === 0 ? undefined : rounded);
    }

    /**
     * Saves the layouts in use, the first the default.
     * @param {array} list  [{ layout, variant }]
     */
    function setLayouts(list) {
        Settings.set("keyboardLayouts", valid(list).length > 0 ? valid(list) : undefined);
    }

    /**
     * Returns a layout's name in the shell's language, or its xkb name while the names are not loaded.
     * @param {object} entry  { layout, variant }
     * @returns {string}
     */
    function nameOf(entry) {
        const found = catalog.find(c => c.layout === entry.layout && c.variant === entry.variant);
        return found?.name ?? (entry.variant ? `${entry.layout} (${entry.variant})` : entry.layout);
    }

    /**
     * Returns the short label of a layout for the bar, such as PL.
     * @param {object} entry  { layout, variant }
     * @returns {string}
     */
    function labelOf(entry) {
        return (entry?.layout ?? "").toUpperCase();
    }

    /** Switches to the next layout and shows which it is. */
    function nextLayout() {
        if (layouts.length < 2)
            return;
        announce = true;
        Quickshell.execDetached(["hyprctl", "switchxkblayout", "all", "next"]);
    }

    /** Reads the names of all layouts, once. */
    function loadCatalog() {
        if (catalogWanted)
            return;
        catalogWanted = true;
        rulesFile.path = "/usr/share/X11/xkb/rules/evdev.xml";
    }

    /**
     * Turns xkeyboard-config's list into layouts and variants with their English names.
     * @param {string} text  evdev.xml
     * @returns {array} [{ layout, variant, name }]
     */
    function parseRules(text) {
        const unescaped = s => s.replace(/&lt;/g, "<").replace(/&gt;/g, ">").replace(/&quot;/g, "\"").replace(/&apos;/g, "'").replace(/&amp;/g, "&");
        const item = s => ({
                    name: /<name>([^<]*)<\/name>/.exec(s)?.[1] ?? "",
                    description: unescaped(/<description>([^<]*)<\/description>/.exec(s)?.[1] ?? "")
                });
        const list = text.slice(text.indexOf("<layoutList>"), text.indexOf("</layoutList>"));
        const result = [];
        for (const chunk of list.split("<layout>").slice(1)) {
            const [main, ...variants] = chunk.split("<variant>");
            const layout = item(main);
            if (!layout.name)
                continue;
            result.push({
                layout: layout.name,
                variant: "",
                name: layout.description
            });
            for (const v of variants) {
                const variant = item(v);
                if (variant.name)
                    result.push({
                        layout: layout.name,
                        variant: variant.name,
                        name: variant.description
                    });
            }
        }
        return result;
    }

    /** Reads the active layout from Hyprland's main keyboard. */
    function readActive() {
        if (!activeReader.running)
            activeReader.running = true;
    }

    Component.onCompleted: readActive()

    // Names already read follow the shell's language.
    Connections {
        target: I18n

        function onLanguageChanged() {
            if (root.catalogWanted)
                rulesFile.reload();
        }
    }

    // Hyprland reports each switch, from a key, the bar or another tool.
    Connections {
        target: Hyprland

        function onRawEvent(event) {
            if (event.name === "activelayout")
                root.readActive();
        }
    }

    Process {
        id: activeReader
        command: ["hyprctl", "devices", "-j"]
        stdout: StdioCollector {
            onStreamFinished: {
                try {
                    const keyboard = JSON.parse(text).keyboards.find(k => k.main);
                    root.activeIndex = keyboard?.active_layout_index ?? 0;
                } catch (e) {
                    console.warn(log, "unreadable hyprctl devices");
                }
                if (root.announce) {
                    root.announce = false;
                    Indicator.show("layout");
                }
            }
        }
    }

    // The installer's layouts, as localectl reports them, such as "pl" or "pl,us".
    Process {
        running: true
        command: ["localectl", "status"]
        stdout: StdioCollector {
            onStreamFinished: {
                const field = name => (new RegExp(`^\\s*X11 ${name}:\\s*(.*)$`, "m").exec(text)?.[1] ?? "").trim();
                const names = field("Layout").split(",").filter(n => n);
                const variants = field("Variant").split(",");
                root.systemLayouts = root.valid(names.map((n, i) => ({
                            layout: n,
                            variant: variants[i] ?? ""
                        })));
            }
        }
        onExited: root.systemRead = true
    }

    FileView {
        id: configFile
        path: root.configPath
        blockLoading: true
        atomicWrites: true
        printErrors: false
        onSaveFailed: error => console.warn(log, "save:", FileViewError.toString(error))
    }

    FileView {
        id: rulesFile
        printErrors: false
        onLoaded: {
            const parsed = root.parseRules(text());
            if (I18n.language === "en") {
                root.catalog = parsed;
                return;
            }
            translator.parsed = parsed;
            translator.environment = {
                LANGUAGE: I18n.language
            };
            // One call for all names, with a separator gettext leaves alone.
            translator.command = ["gettext", "-d", "xkeyboard-config", "-s", ...parsed.reduce((all, l) => all.concat([l.name, "|"]), [])];
            translator.running = true;
        }
        onLoadFailed: console.warn(log, "cannot read the list of keyboard layouts")
    }

    // The names in the shell's language, where xkeyboard-config has them.
    Process {
        id: translator

        property var parsed: []

        stdout: StdioCollector {
            onStreamFinished: {
                const names = text.replace(/\s*\|?\s*$/, "").split(" | ");
                root.catalog = names.length === translator.parsed.length ? translator.parsed.map((l, i) => Object.assign({}, l, {
                        name: names[i]
                    })) : translator.parsed;
            }
        }
    }

    Process {
        running: true
        command: ["sh", "-c", "grep -qsx 'E:ID_INPUT_TOUCHPAD=1' /run/udev/data/c13:*"]
        onExited: code => root.touchpadPresent = code === 0
    }

    IpcHandler {
        target: "input"

        function nextLayout(): void {
            root.nextLayout();
        }
        function describe(): string {
            return JSON.stringify({
                layouts: root.layouts,
                active: root.activeIndex,
                names: root.layouts.map(l => root.nameOf(l)),
                pointerSpeed: root.pointerSpeed,
                tapToClick: root.tapToClick,
                naturalScroll: root.naturalScroll
            });
        }
    }

    LoggingCategory {
        id: log
        name: "hyprdora.input"
    }
}
