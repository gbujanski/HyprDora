<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>HyprDora</vendor>
  <vendor_url>https://github.com/gbujanski/HyprDora</vendor_url>

  <action id="org.hyprdora.update-settings">
    <description>Change how the system looks for updates</description>
    <description xml:lang="pl">Zmiana sposobu szukania aktualizacji</description>
    <message>Authentication is required to change how the system looks for updates</message>
    <message xml:lang="pl">Wymagane jest uwierzytelnienie, aby zmienić sposób szukania aktualizacji</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/hyprdora/update-settings</annotate>
  </action>

  <!-- Only refreshes the package cache, so the active user needs no password. -->
  <action id="org.hyprdora.update-check">
    <description>Look for updates</description>
    <description xml:lang="pl">Szukanie aktualizacji</description>
    <message>Authentication is required to look for updates</message>
    <message xml:lang="pl">Wymagane jest uwierzytelnienie, aby poszukać aktualizacji</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/hyprdora/update-check</annotate>
  </action>
</policyconfig>
