pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import qs.config

// The touchpad's scrolling direction. Hyprland reads it from input.lua in the user's Hyprland directory, which
// the shell writes, as it writes monitors.lua; a change also applies at once. The user's settings.lua loads
// after it and wins.
Singleton {
    id: root

    // Whether this computer has a touchpad, from udev; settings for it show only then.
    property bool present: false
    readonly property bool naturalScroll: Settings.touchpadNaturalScroll
    readonly property string configPath: `${Settings.configDir}/hypr/input.lua`

    /**
     * Sets the scrolling direction, saves it for Hyprland and applies it now.
     * @param {bool} natural  true to move the content with the fingers, as on a phone
     */
    function setNaturalScroll(natural) {
        Settings.set("touchpadNaturalScroll", natural ? true : undefined);
        const rule = `hl.config({ input = { touchpad = { natural_scroll = ${natural} } } })`;
        configFile.setText(`-- Generated by the HyprDora shell. Do not edit.\n${rule}\n`);
        Quickshell.execDetached(["hyprctl", "eval", rule]);
    }

    FileView {
        id: configFile
        path: root.configPath
        atomicWrites: true
        printErrors: false
        onSaveFailed: error => console.warn("touchpad: save:", FileViewError.toString(error))
    }

    Process {
        running: true
        command: ["sh", "-c", "grep -qsx 'E:ID_INPUT_TOUCHPAD=1' /run/udev/data/c13:*"]
        onExited: code => root.present = code === 0
    }
}
