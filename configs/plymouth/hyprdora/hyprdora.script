# HyprDora boot theme: black, with the login screen's ">:" prompt in the same place, so the login screen
# follows without a visible change. Starting types a short log, each line moving up when the next begins,
# with "[ ok ]" in place of the prompt, starting where ">:" does; the pace follows Plymouth's estimate of the boot, so it never makes the boot longer.
# Powering off or restarting types a shorter one. Installing updates shows a text progress bar, and a disk
# password shows as stars after the prompt. A driver being built after a kernel update shows under the
# prompt. Plymouth scripts read only decimal numbers.

# Written when the package installs.
version = "0";

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

# The login screen's accent, #2fcf5e, and a dimmer shade for finished lines.
green.r = 47 / 255; green.g = 207 / 255; green.b = 94 / 255;
dim.r = 28 / 255; dim.g = 124 / 255; dim.b = 56 / 255;
# The login screen uses 16 pixels.
font = "Monospace 16px";

fun green_text(s) {
    return Image.Text(s, green.r, green.g, green.b, 1, font);
}

fun dim_text(s) {
    return Image.Text(s, dim.r, dim.g, dim.b, 1, font);
}

# The login screen centers a row of ">:", 10 pixels, and a 300 pixel field; the prompt sits where it does.
prompt.image = green_text(">:");
prompt.sprite = Sprite(prompt.image);
prompt.x = Math.Int(Window.GetWidth() / 2 - (prompt.image.GetWidth() + 10 + 300) / 2);
prompt.y = Math.Int(Window.GetHeight() / 2 - prompt.image.GetHeight() / 2);
prompt.sprite.SetPosition(prompt.x, prompt.y, 10);
field.x = prompt.x + prompt.image.GetWidth() + 10;
line_height = Math.Int(prompt.image.GetHeight() * 1.6);

current.sprite = Sprite();
current.sprite.SetPosition(field.x, prompt.y, 10);
current.shown = "-";

cursor.image = green_text("█");
cursor.sprite = Sprite(cursor.image);
cursor.sprite.SetPosition(field.x, prompt.y, 10);

ok.image = green_text("[ ok ]");

# Each line, and the share of the boot after which it may start. "mounting root filesystem" ends when
# Plymouth reports the root filesystem mounted, a real event.
boot.text[0] = "hyprdora " + version; boot.at[0] = 0;
boot.text[1] = "initializing kernel"; boot.at[1] = 0.05;
boot.text[2] = "mounting root filesystem"; boot.at[2] = 0.15;
boot.text[3] = "loading drivers"; boot.at[3] = 0.35;
boot.text[4] = "starting system services"; boot.at[4] = 0.55;
boot.text[5] = "securing session"; boot.at[5] = 0.80;
boot.text[6] = "ready"; boot.at[6] = 0.95;
boot.count = 7;

down.text[0] = "stopping services"; down.at[0] = 0;
down.text[1] = "syncing disks"; down.at[1] = 0.3;
down.text[2] = "goodbye"; down.at[2] = 0.6;
down.count = 3;

frame = 0;
progress = 0;
root_mounted = 0;
step = 0;
typed = 0;
logged = 0;
password.active = 0;
password.prompt = "";
update.progress = 0;
update.shown = -1;
akmod.text = "";
message.text = "";

fun is_update_mode() {
    local.mode = Plymouth.GetMode();
    return local.mode == "updates" || local.mode == "system-upgrade" || local.mode == "firmware-upgrade";
}

fun is_down_mode() {
    local.mode = Plymouth.GetMode();
    return local.mode == "shutdown" || local.mode == "reboot";
}

fun line_text(i) {
    if (is_down_mode()) {
        if (i == 2 && Plymouth.GetMode() == "reboot")
            return "rebooting";
        return global.down.text[i];
    }
    return global.boot.text[i];
}

fun line_count() {
    if (is_down_mode())
        return global.down.count;
    return global.boot.count;
}

# Whether line i may start. Without a progress estimate, about twelve seconds of frames stand in for it.
fun may_start(i) {
    if (is_down_mode())
        return global.frame >= global.down.at[i] * 150;
    if (i == 3 && !global.root_mounted && global.frame < 400)
        return 0;
    return global.progress >= global.boot.at[i] || global.frame >= global.boot.at[i] * 600;
}

# Shows text after the prompt with the cursor right behind it, redrawing only when it changes.
fun show_current(s) {
    if (s != global.current.shown) {
        global.current.shown = s;
        if (s == "") {
            global.current.sprite.SetOpacity(0);
            global.cursor.sprite.SetX(global.field.x);
        } else {
            global.current.image = green_text(s);
            global.current.sprite.SetImage(global.current.image);
            global.current.sprite.SetOpacity(1);
            global.cursor.sprite.SetX(global.field.x + global.current.image.GetWidth());
        }
    }
}

# Moves the finished line up into the log: earlier lines rise by one line, the newest sits just above.
fun log_line(s) {
    for (local.i = 0; local.i < global.logged; local.i++) {
        local.y = global.log[local.i].text.GetY() - global.line_height;
        global.log[local.i].text.SetY(local.y);
        global.log[local.i].ok.SetY(local.y);
    }
    local.y = global.prompt.y - global.line_height;
    global.log[global.logged].ok = Sprite(global.ok.image);
    global.log[global.logged].ok.SetPosition(global.prompt.x, local.y, 10);
    global.log[global.logged].text = Sprite(dim_text(s));
    global.log[global.logged].text.SetPosition(global.prompt.x + global.ok.image.GetWidth() + 10, local.y, 10);
    global.logged++;
}

fun set_log_opacity(opacity) {
    for (local.i = 0; local.i < global.logged; local.i++) {
        global.log[local.i].text.SetOpacity(opacity);
        global.log[local.i].ok.SetOpacity(opacity);
    }
}

# Types the current line; when it is complete and the next may start, logs it and begins the next. Typing
# speeds up when lines are waiting, so the log keeps up with a fast boot.
fun advance() {
    local.text = line_text(global.step);
    local.length = String(local.text).Length();
    if (global.typed < local.length) {
        local.waiting = 0;
        for (local.i = global.step + 1; local.i < line_count(); local.i++)
            if (may_start(local.i))
                local.waiting++;
        global.typed = global.typed + 1 + local.waiting;
        if (global.typed > local.length)
            global.typed = local.length;
    } else if (global.step + 1 < line_count() && may_start(global.step + 1)) {
        log_line(local.text);
        global.step++;
        global.typed = 0;
    }
    show_current(String(line_text(global.step)).SubString(0, global.typed));
}

# Twenty blocks, one per 5%, such as [█████████░░░░░░░░░░░] 45%.
fun progress_bar(percent) {
    local.bar = "[";
    for (local.i = 0; local.i < 20; local.i++) {
        if (local.i < percent / 5)
            local.bar = local.bar + "█";
        else
            local.bar = local.bar + "░";
    }
    return local.bar + "] " + Math.Int(percent) + "%";
}

fun show_update() {
    set_log_opacity(0);
    show_current("installing updates");
    if (global.update.shown != global.update.progress) {
        global.update.shown = global.update.progress;
        global.bar.image = green_text(progress_bar(global.update.progress));
        global.bar.sprite = Sprite(global.bar.image);
        global.bar.sprite.SetPosition(global.field.x, global.prompt.y + global.line_height * 2, 10);
        global.note.image = dim_text("do not power off");
        global.note.sprite = Sprite(global.note.image);
        global.note.sprite.SetPosition(global.field.x, global.prompt.y + global.line_height * 4, 10);
    }
}

fun refresh() {
    global.frame++;
    if (is_update_mode()) {
        show_update();
    } else {
        if (global.password.active) {
            local.stars = "";
            for (local.i = 0; local.i < global.password.bullets; local.i++)
                local.stars = local.stars + "*";
            show_current(local.stars);
        } else {
            advance();
        }
    }
    # The cursor blinks every half second, as on the login screen; refresh runs 50 times a second.
    if (Math.Int(global.frame / 25) == Math.Int(global.frame / 50) * 2)
        global.cursor.sprite.SetOpacity(1);
    else
        global.cursor.sprite.SetOpacity(0);
}

Plymouth.SetRefreshFunction(refresh);

fun boot_progress(duration, value) {
    global.progress = value;
}

fun root_mounted_now() {
    global.root_mounted = 1;
}

fun display_password(prompt_text, bullets) {
    global.password.active = 1;
    global.password.bullets = bullets;
    if (prompt_text != global.password.prompt) {
        global.password.prompt = prompt_text;
        global.question.image = dim_text(prompt_text);
        global.question.sprite = Sprite(global.question.image);
        global.question.sprite.SetPosition(global.field.x, global.prompt.y + global.line_height * 2, 10);
    }
}

# After the password the log carries on where it was.
fun display_normal() {
    if (global.password.active) {
        global.password.active = 0;
        global.password.prompt = "";
        global.question.sprite.SetOpacity(0);
        global.current.shown = "-";
    }
}

fun system_update(value) {
    global.update.progress = value;
}

fun starts_with(s, prefix) {
    local.n = String(prefix).Length();
    return String(s).Length() >= local.n && String(s).SubString(0, local.n) == prefix;
}

fun ends_with(s, suffix) {
    local.length = String(s).Length();
    local.n = String(suffix).Length();
    return local.length >= local.n && String(s).SubString(local.length - local.n, local.length) == suffix;
}

# The driver's name in akmods' message: "facetimehd" in "akmod: Building /usr/src/akmods/facetimehd-kmod.latest...".
fun akmod_name(s) {
    local.length = String(s).Length();
    local.start = 0;
    for (local.i = 0; local.i < local.length; local.i++)
        if (String(s).CharAt(local.i) == "/")
            local.start = local.i + 1;
    for (local.end = local.start; local.end + 5 <= local.length; local.end++)
        if (String(s).SubString(local.end, local.end + 5) == "-kmod")
            return String(s).SubString(local.start, local.end);
    return String(s).SubString(local.start, local.length);
}

# akmods builds a driver, such as the FaceTime camera's, at the first boot of a new kernel, which takes a
# minute or two; its message says so under the prompt, in the log's words, and an explanation below.
fun show_akmod(s) {
    local.name = akmod_name(s);
    if (ends_with(s, "failed!")) {
        local.line = local.name + " driver failed to build";
        local.note = "see /var/cache/akmods";
    } else {
        if (starts_with(s, "akmod: Installing"))
            local.line = "installing " + local.name + " driver";
        else
            local.line = "building " + local.name + " driver";
        local.note = "after a kernel update, this takes a minute or two";
    }
    global.akmod.text = s;
    global.akmod.line.sprite = Sprite(green_text(local.line));
    global.akmod.line.sprite.SetPosition(global.field.x, global.prompt.y + global.line_height * 2, 10);
    global.akmod.note.sprite = Sprite(dim_text(local.note));
    global.akmod.note.sprite.SetPosition(global.field.x, global.prompt.y + global.line_height * 3, 10);
}

# Other messages, such as from a disk check, show dimmed near the bottom.
fun show_message(s) {
    if (starts_with(s, "akmod: ")) {
        show_akmod(s);
        return;
    }
    global.message.text = s;
    global.message.image = dim_text(s);
    global.message.sprite = Sprite(global.message.image);
    global.message.sprite.SetPosition(Math.Int(Window.GetWidth() / 2 - global.message.image.GetWidth() / 2), Window.GetHeight() - global.message.image.GetHeight() * 3, 10);
}

# akmods never hides its messages itself; HyprDora's addition to its service does once the build is done.
# A message that has already been replaced by a newer one stays as it is.
fun hide_message(s) {
    if (s == global.akmod.text) {
        global.akmod.text = "";
        global.akmod.line.sprite.SetOpacity(0);
        global.akmod.note.sprite.SetOpacity(0);
    }
    if (s == global.message.text) {
        global.message.text = "";
        global.message.sprite.SetOpacity(0);
    }
}

Plymouth.SetBootProgressFunction(boot_progress);
Plymouth.SetRootMountedFunction(root_mounted_now);
Plymouth.SetDisplayPasswordFunction(display_password);
Plymouth.SetDisplayNormalFunction(display_normal);
Plymouth.SetSystemUpdateFunction(system_update);
Plymouth.SetDisplayMessageFunction(show_message);
Plymouth.SetHideMessageFunction(hide_message);
